{
  "name": "interview-whisperer",
  "description": "Interview Whisperer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "packages/entry-point.js",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=23.0.0"
  },
  "scripts": {
    "dev": "node packages/dev-mode.js",
    "build": "npm run build -ws --if-present",
    "compile": "npm run build && electron-builder build --config electron-builder.mjs"
  },
  "devDependencies": {
    "@npmcli/map-workspaces": "4.0.2",
    "@types/node": "22.10.2",
    "electron": "33.2.1",
    "electron-builder": "26.0.0-alpha.8"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.2.1",
    "@vite-electron-builder/main": "*",
    "ai": "^4.1.54",
    "openai": "^4.86.2"
  }
}
